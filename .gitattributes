# Keep Python sources LF on all platforms (prevents CRLF conversion warnings).
*.py text eol=lf

# Keep web assets + configs LF to avoid CRLF churn on Windows checkouts.
*.css text eol=lf
*.js text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.txt text eol=lf
