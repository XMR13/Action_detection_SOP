# Keep this file readable only by root and the service group.
SOP_RTSP_URL="rtsp://USER:PASSWORD@CAMERA_IP:554/STREAM_PATH"

# Relative paths are resolved from the repository working directory.
SOP_MODEL_PATH="Models/SOP_model.engine"
SOP_METADATA_PATH="configs/metadata_roll_sop_v1.yaml"
SOP_ROI_PATH="configs/roi_new_v3.json"

# Conservative one-camera defaults. Tune only from measured live evidence.
SOP_IMAGE_SIZE="640"
SOP_CONFIDENCE="0.35"
SOP_ANALYSIS_FPS="5"
SOP_RTSP_BUFFER_SIZE="1"
SOP_RTSP_OPEN_TIMEOUT_MS="10000"
SOP_RTSP_READ_TIMEOUT_MS="5000"
SOP_RECONNECT_WAIT_S="1"
SOP_RECONNECT_WAIT_MAX_S="30"
SOP_RECONNECT_BACKOFF="1.5"
