# Bind to the LAN for the on-prem pilot. Restrict access with the host firewall.
SOP_WEB_HOST="0.0.0.0"
SOP_WEB_PORT="8000"

# Change this before starting the service.
SOP_ADMIN_USERNAME="admin"
SOP_ADMIN_PASSWORD="CHANGE_ME"

# The installer replaces the database path using its resolved --data-dir.
SOP_WEB_DB_PATH="@DATA_DIR@/web_mvp.sqlite3"

# Same-host viewer mode: discover new runner artifacts quickly.
SOP_AUTO_RESCAN_S="5"
